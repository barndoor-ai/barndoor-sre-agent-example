# Copy to .env and fill in. Every example and script reads this file.
# Never commit .env (it is gitignored).

# --- The SRE agent's Barndoor identity (machine-to-machine) -----------------
# From Barndoor: Agents -> Add agent, with "MCP Connections" turned on.
# The secret is shown once, when the agent is created.
BARNDOOR_CLIENT_ID=
BARNDOOR_CLIENT_SECRET=
# Barndoor environment for the CLI (leave as prod for a trial account).
BARNDOOR_ENV=prod

# --- The agent's brain: Claude Code through the Barndoor LLM gateway --------
# No trailing /v1; Claude Code appends /v1/messages itself.
LLM_GATEWAY_URL=https://app.barndoor.ai/api/llm-gateway
# The model name exactly as listed under the gateway's Available Models: a
# route name (scripts/setup-llm-gateway.sh creates one called sre-agent) or a
# provider-prefixed model like "Anthropic SRE Example/claude-sonnet-5-5".
LLM_MODEL=sre-agent
# A Barndoor LLM gateway API key (starts with bd-), ideally bound to the SRE
# agent: AI Agents -> <agent> -> ⋮ -> Manage keys -> Create new key.
ANTHROPIC_AUTH_TOKEN=
# Only for scripts/setup-llm-gateway.sh: the Anthropic key the gateway uses
# upstream. Trial orgs start with no LLM provider configured.
# ANTHROPIC_UPSTREAM_API_KEY=

# --- Terraform (examples 02 and 03, optional for 01) -------------------------
# An org-admin credential, NOT the agent's: Settings -> API Tokens ->
# Terraform provider credentials. Copy base URL, token URL and organization
# id from the same panel.
BARNDOOR_TF_CLIENT_ID=
BARNDOOR_TF_CLIENT_SECRET=
BARNDOOR_TF_BASE_URL=https://platform.barndoor.ai
BARNDOOR_TF_TOKEN_URL=
BARNDOOR_ORGANIZATION_ID=
# Display name you gave the agent in the console (keep the quotes).
SRE_AGENT_NAME="SRE Example Agent"

# --- Optional ----------------------------------------------------------------
# Port for bobi's local event server (alert sources POST here).
# SRE_EVENT_PORT=8080
# Path to the barndoor CLI if it is not on PATH.
# BARNDOOR_BIN=/usr/local/bin/barndoor
